# EAS runs from apps/mobile; upload only this self-contained app.
/*
!/.easignore
!/apps
/apps/*
!/apps/mobile
/apps/mobile/*
!/apps/mobile/App.tsx
!/apps/mobile/index.ts
!/apps/mobile/app.json
!/apps/mobile/eas.json
!/apps/mobile/package.json
!/apps/mobile/package-lock.json
!/apps/mobile/tsconfig.json
!/apps/mobile/metro.config.cjs
!/apps/mobile/eslint.config.js
!/apps/mobile/vitest.config.mts
!/apps/mobile/LICENSE
!/apps/mobile/src
!/apps/mobile/plugins
!/apps/mobile/assets

# Never include runtime data, credentials, generated code or repository history.
**/.git
**/node_modules
**/.expo
**/android
**/ios
**/artifacts
**/.env
**/.env.*
**/credentials.json
**/*.jks
**/*.keystore
**/*.p8
**/*.p12
**/*.pem
**/*.key
**/*.mobileprovision
**/*.db
**/*.db-*
**/*.sqlite*
**/*.log
